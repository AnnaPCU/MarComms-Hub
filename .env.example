# ════════════════════════════════════════════════════════════════════
# MARCOMMS HUB — Variables de entorno
# ════════════════════════════════════════════════════════════════════
# 1. Copiá este archivo como `.env.local`
# 2. Reemplazá los valores con los reales
# 3. NUNCA commitees `.env.local` (ya está en .gitignore)
#
# En Vite, las variables expuestas al cliente DEBEN empezar con VITE_
# ════════════════════════════════════════════════════════════════════

# ─── App Config ───
VITE_APP_NAME=Marcomms Hub
VITE_APP_VERSION=1.0.0

# ─── Password compartida (modo demo) ───
# TODO: reemplazar con auth real de Supabase cuando esté listo
VITE_SHARED_PASSWORD=marcomms2026

# ─── Supabase (pendiente, NO usar todavía) ───
# Descomentar cuando integremos backend
# VITE_SUPABASE_URL=https://xxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJxxxxx

# ─── Anthropic API (para feature de Reporte Mailchimp con IA) ───
# IMPORTANTE: NO exponer la API key al cliente.
# Esto debería ir vía edge function de Supabase o API route de Vercel.
# Solo dejamos esta variable comentada como referencia.
# ANTHROPIC_API_KEY=sk-ant-xxx  (sin VITE_, server-only)
