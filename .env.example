# ════════════════════════════════════════════════════════════════════
# MARCOMMS HUB — Variables de entorno
# ════════════════════════════════════════════════════════════════════
# 1. Copiá este archivo como `.env.local`
# 2. Reemplazá los valores con los reales
# 3. NUNCA commitees `.env.local` (ya está en .gitignore)
#
# En Vite, las variables expuestas al cliente DEBEN empezar con VITE_
# ════════════════════════════════════════════════════════════════════

# ─── App Config ───
VITE_APP_NAME=Marcomms Hub
VITE_APP_VERSION=1.0.0

# ─── Password compartida (modo demo, NO es seguridad real) ───
# TODO: reemplazar por Supabase Auth en una fase futura.
VITE_SHARED_PASSWORD=marcomms2026

# ─── Supabase (REQUERIDAS) ─────────────────────────────────────
# Estas variables son OBLIGATORIAS para que la app arranque, porque
# `src/lib/supabaseClient.js` valida que estén definidas.
#
# Tomarlas desde Supabase Dashboard → Project Settings → API:
#   - URL                  → VITE_SUPABASE_URL
#   - Publishable key      → VITE_SUPABASE_PUBLISHABLE_KEY
#
# NUNCA poner acá el service role key ni el database password —
# este archivo se sube al repo. Las claves secretas se manejan
# server-side (edge functions, Vercel secrets, etc.).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ─── HubSpot forms (URLs externas) ─────────────────────────────
# Si NO se definen, se usan los fallbacks hardcodeados en
# src/constants/externalLinks.js (los forms actuales). Conviene
# definirlas en Vercel para que rotaciones de URL no requieran redeploy.
VITE_HS_FORM_MARCOMMS_URL=
VITE_HS_FORM_HSREQUEST_URL=
